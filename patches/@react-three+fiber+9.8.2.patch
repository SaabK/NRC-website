diff --git a/node_modules/@react-three/fiber/dist/events-0dab3c53.cjs.dev.js b/node_modules/@react-three/fiber/dist/events-0dab3c53.cjs.dev.js
index 705fbd5..c515cc8 100644
--- a/node_modules/@react-three/fiber/dist/events-0dab3c53.cjs.dev.js
+++ b/node_modules/@react-three/fiber/dist/events-0dab3c53.cjs.dev.js
@@ -1229,7 +1229,38 @@ const createStore = (invalidate, advance) => {
       linear: false,
       flat: false,
       controls: null,
-      clock: new THREE__namespace.Clock(),
+      clock: (() => {
+        const timer = new THREE__namespace.Timer();
+        if (typeof document !== 'undefined') timer.connect(document);
+        timer.elapsedTime = 0;
+        timer.oldTime = 0;
+        timer.running = true;
+        timer.autoStart = true;
+        const getDelta = timer.getDelta.bind(timer);
+        timer.getDelta = () => {
+          if (!timer.running) {
+            if (timer.autoStart) timer.start();
+            return 0;
+          }
+          timer.update();
+          const delta = getDelta();
+          timer.elapsedTime += delta;
+          return delta;
+        };
+        timer.start = () => {
+          timer.reset();
+          timer.elapsedTime = 0;
+          timer.running = true;
+        };
+        timer.stop = () => {
+          timer.running = false;
+        };
+        timer.getElapsedTime = () => {
+          timer.getDelta();
+          return timer.elapsedTime;
+        };
+        return timer;
+      })(),
       pointer,
       mouse: pointer,
       frameloop: 'always',
